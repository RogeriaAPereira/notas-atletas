// Recebe uma matriz de atletas, cada um com nome e 5 notas.
// Para cada atleta:
// - ordena as notas numericamente (crescente)
// - remove a menor e a maior (pega as 3 do meio)
// - calcula a média dessas 3 notas
// - imprime o nome, as notas obtidas (ordenadas) e a média válida

function calcularMediaValidas(atletas) {
  for (let i = 0; i < atletas.length; i++) {
    const atleta = atletas[i];
    // Criar uma cópia das notas para não modificar o original
    let notas = [...atleta.notas];

    // Ordena numericamente (crescente)
    notas.sort((a, b) => a - b);

    // Notas computadas: remove a menor e a maior (pega as 3 do meio)
    const notasComputadas = notas.slice(1, 4);

    // Soma das notas computadas
    const soma = notasComputadas.reduce((acc, cur) => acc + cur, 0);

    // Média válida (das 3 do meio)
    const mediaValida = soma / notasComputadas.length;

    // Monta saída
    console.log(`Atleta: ${atleta.nome}`);
    console.log(`Notas Obtidas: ${notas.join(',')}`);
    console.log(`Média Válida: ${mediaValida}`);
    console.log(''); // linha em branco entre atletas
  }
}

// Entrada fornecida no enunciado
let atletas = [
  {
    nome: "Cesar Abascal",
    notas: [10, 9.34, 8.42, 10, 7.88]
  },
  {
    nome: "Fernando Puntel",
    notas:  [8, 10, 10, 7, 9.33]
  },
  {
    nome: "Daiane Jelinsky",
    notas: [7, 10, 9.5, 9.5, 8]
  },
  {
    nome: "Bruno Castro",
    notas: [10, 10, 10, 9, 9.5]
  }
];

// Executa a função
calcularMediaValidas(atletas);
